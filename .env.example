# Copie para apps/api/.env. O script npm run db:prepare gera esse arquivo
# automaticamente na primeira execução local.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/mpagenda?schema=public
NODE_ENV=development
PORT=3333
JWT_ACCESS_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
COOKIE_SECURE=false

# E-mail transacional. Sem estas variáveis, recuperação de senha e lembretes
# respondem que o envio não está configurado — o sistema não simula o envio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MP Agenda <nao-responda@example.com>

# Opcional. Sem estas variáveis, a sincronização com Google Calendar fica desligada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Protege o endpoint de lembretes quando um agendador externo o chamar.
CRON_SECRET=

# Frontend (apps/web/.env). Vazio usa o proxy do Vite em /api.
VITE_API_URL=
