generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFESSIONAL
  CUSTOMER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Plan {
  id                      String     @id @default(cuid())
  code                    String     @unique
  name                    String
  maxProfessionals        Int
  maxAppointmentsPerMonth Int
  createdAt               DateTime @db.Timestamptz(3)   @default(now())
  updatedAt               DateTime @db.Timestamptz(3)   @updatedAt
  businesses              Business[]
}

model Business {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  phone               String?
  email               String?
  address             String?
  description         String?
  timezone            String   @default("America/Sao_Paulo")
  primaryColor        String   @default("#0E7C66")
  accentColor         String   @default("#C4A574")
  minAdvanceMinutes   Int      @default(60)
  maxAdvanceDays      Int      @default(60)
  cancelMinHours      Int      @default(2)
  slotIntervalMinutes Int      @default(30)
  bufferMinutes       Int      @default(0)
  autoConfirm         Boolean  @default(true)
  isDemo              Boolean  @default(false)
  planId              String
  plan                Plan     @relation(fields: [planId], references: [id])
  createdAt           DateTime @db.Timestamptz(3) @default(now())
  updatedAt           DateTime @db.Timestamptz(3) @updatedAt

  memberships   BusinessMembership[]
  customers     Customer[]
  professionals Professional[]
  services      Service[]
  workingHours  BusinessWorkingHours[]
  timeOffs      TimeOff[]
  appointments  Appointment[]
  auditLogs     AuditLog[]

  @@index([planId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @db.Timestamptz(3) @default(now())
  updatedAt    DateTime @db.Timestamptz(3) @updatedAt

  memberships         BusinessMembership[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  customers           Customer[]
  professionals       Professional[]
}

model BusinessMembership {
  id             String        @id @default(cuid())
  userId         String
  businessId     String
  role           Role
  professionalId String?       @unique
  createdAt      DateTime @db.Timestamptz(3)      @default(now())
  updatedAt      DateTime @db.Timestamptz(3)      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@unique([userId, businessId])
  @@index([businessId, role])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  name       String
  email      String?
  phone      String
  notes      String?
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  updatedAt  DateTime @db.Timestamptz(3) @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([userId])
}

model Professional {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  name       String
  email      String?
  phone      String?
  bio        String?
  color      String   @default("#0E7C66")
  active     Boolean  @default(true)
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  updatedAt  DateTime @db.Timestamptz(3) @updatedAt

  business     Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership   BusinessMembership?
  services     ProfessionalService[]
  workingHours ProfessionalWorkingHours[]
  timeOffs     TimeOff[]
  appointments Appointment[]

  @@index([businessId, active])
  @@index([userId])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  bufferMinutes   Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @db.Timestamptz(3) @default(now())
  updatedAt       DateTime @db.Timestamptz(3) @updatedAt

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([businessId, active])
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

model BusinessWorkingHours {
  id         String   @id @default(cuid())
  businessId String
  weekday    Int
  startTime  String
  endTime    String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, weekday])
}

model ProfessionalWorkingHours {
  id             String       @id @default(cuid())
  professionalId String
  weekday        Int
  startTime      String
  endTime        String
  breakStart     String?
  breakEnd       String?
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, weekday])
}

model TimeOff {
  id             String        @id @default(cuid())
  businessId     String
  professionalId String?
  startsAt       DateTime @db.Timestamptz(3)
  endsAt         DateTime @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime @db.Timestamptz(3)      @default(now())
  updatedAt      DateTime @db.Timestamptz(3)      @updatedAt
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
  @@index([professionalId, startsAt])
}

model Appointment {
  id             String            @id @default(cuid())
  businessId     String
  professionalId String
  serviceId      String
  customerId     String
  startsAt       DateTime @db.Timestamptz(3)
  endsAt         DateTime @db.Timestamptz(3)
  blockedUntil   DateTime @db.Timestamptz(3)
  status         AppointmentStatus @default(PENDING)
  notes          String?
  priceSnapshot  Decimal           @db.Decimal(10, 2)
  cancelReason   String?
  idempotencyKey String?
  reminderSentAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime @db.Timestamptz(3)          @default(now())
  updatedAt      DateTime @db.Timestamptz(3)          @updatedAt

  business     Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional             @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service      Service                  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer     Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  accessTokens AppointmentAccessToken[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, startsAt])
  @@index([professionalId, startsAt])
  @@index([customerId])
  @@index([businessId, status, startsAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  userAgent String?
  createdAt DateTime @db.Timestamptz(3)  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @db.Timestamptz(3)  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppointmentAccessToken {
  id            String      @id @default(cuid())
  appointmentId String
  tokenHash     String      @unique
  expiresAt     DateTime @db.Timestamptz(3)
  createdAt     DateTime @db.Timestamptz(3)    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
